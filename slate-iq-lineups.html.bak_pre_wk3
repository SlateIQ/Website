<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;border:0 solid #e5e7eb}
html{font-family:Inter,ui-sans-serif,system-ui,sans-serif;line-height:1.5;scroll-behavior:smooth}
body{-webkit-font-smoothing:antialiased;background:#fff;color:#0B2545}
a{color:inherit;text-decoration:none}
ul{list-style:none}
:root{--green:#00A94F;--green-dark:#007A38;--green-light:#E6F7ED;--green-border:rgba(0,169,79,0.3);--gold:#B7791F;--gold-light:#FDF3DD;--blue:#2563EB;--blue-light:#EFF6FF;--purple:#7C3AED;--purple-light:#F5F3FF;--navy:#0B2545;--navy-dark:#081B33;--navy-light:#13345C;--gray-50:#f9fafb;--gray-100:#f3f4f6;--gray-200:#e5e7eb}
.container{max-width:80rem;margin:0 auto;padding:0 1.5rem}
@media(min-width:1024px){.container{padding:0 2rem}}

header{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.95);backdrop-filter:blur(4px);border-bottom:1px solid var(--gray-100)}
nav{max-width:80rem;margin:0 auto;padding:0 1.5rem;height:4rem;display:flex;align-items:center;justify-content:space-between}
.nav-logo-svg{height:32px;width:auto}
.nav-back{display:flex;align-items:center;gap:.4rem;font-size:.875rem;font-weight:500;color:rgba(11,37,69,.7);transition:color .15s}
.nav-back:hover{color:var(--green)}
.nav-back svg{width:1rem;height:1rem;stroke:currentColor;fill:none;stroke-width:2}
.nav-right{display:flex;align-items:center;gap:1.25rem}

.page-hero{background:linear-gradient(to bottom,var(--navy-light),var(--navy));color:#fff;padding:6rem 0 4rem;position:relative;overflow:hidden}
@media(min-width:1024px){.page-hero{padding:8rem 0 5rem}}
.page-hero-bg{position:absolute;inset:0;opacity:.08;pointer-events:none}
.page-hero-bg circle{fill:var(--green)}
.hero-eyebrow{display:inline-block;background:rgba(0,169,79,.15);color:rgba(230,247,237,1);font-size:.75rem;font-weight:600;letter-spacing:.025em;text-transform:uppercase;padding:.25rem .75rem;border-radius:9999px;margin-bottom:1.25rem;border:1px solid var(--green-border)}
.page-hero h1{font-size:2.25rem;font-weight:800;line-height:1.2;margin-bottom:1rem}
@media(min-width:640px){.page-hero h1{font-size:3rem;line-height:1.1}}
.page-hero p{font-size:1.0625rem;color:rgba(255,255,255,.75);max-width:38rem;line-height:1.65}

/* jump nav */
.jumpnav-wrap{position:sticky;top:4rem;z-index:40;background:#fff;border-bottom:1px solid var(--gray-100);overflow-x:auto}
.jumpnav{display:flex;gap:.6rem;padding:.85rem 1.5rem;max-width:80rem;margin:0 auto;white-space:nowrap}
@media(min-width:1024px){.jumpnav{padding:.85rem 2rem}}
.jumpnav a{font-size:.8125rem;font-weight:600;color:rgba(11,37,69,.75);background:var(--gray-50);border:1px solid var(--gray-100);border-radius:9999px;padding:.4rem .95rem;transition:color .15s,border-color .15s,background .15s}
.jumpnav a:hover{color:var(--green-dark);border-color:var(--green-border);background:var(--green-light)}

.lineup-section{padding:4rem 0;border-top:1px solid var(--gray-100);scroll-margin-top:8rem}
.lineup-section:nth-child(even){background:var(--gray-50)}
.lineup-tag{display:inline-block;font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em;padding:.3rem .7rem;border-radius:9999px;margin-bottom:1rem}
.tag-cash{background:var(--green-light);color:var(--green-dark)}
.tag-gpp{background:var(--gold-light);color:var(--gold)}
.tag-balanced{background:var(--blue-light);color:var(--blue)}
.tag-hybrid{background:var(--purple-light);color:var(--purple)}
.lineup-section h2{font-size:1.75rem;font-weight:800;color:var(--navy);line-height:1.25;margin-bottom:.75rem;max-width:42rem}
.lineup-excerpt{font-size:1.0625rem;color:rgba(11,37,69,.65);max-width:42rem;line-height:1.6;margin-bottom:1.75rem}

.lineup-stats-row{display:flex;flex-wrap:wrap;gap:.85rem;margin-bottom:2rem}
.lineup-stat-pill{background:#fff;border:1px solid var(--gray-100);border-radius:.5rem;padding:.6rem 1.1rem;box-shadow:0 1px 3px rgba(0,0,0,.04)}
.lineup-stat-pill .v{font-size:1.15rem;font-weight:700;color:var(--green-dark);display:block}
.lineup-stat-pill .l{font-size:.65rem;color:rgba(11,37,69,.5);text-transform:uppercase;letter-spacing:.05em}

.article-body{max-width:42rem}
.article-body h3{font-size:1.1875rem;font-weight:700;color:var(--navy);margin:2rem 0 .85rem}
.article-body h3:first-child{margin-top:0}
.article-body p{font-size:.9375rem;line-height:1.75;color:rgba(11,37,69,.75);margin-bottom:1rem}
.article-body p:last-child{margin-bottom:0}
.article-body strong{color:var(--navy);font-weight:600}
.article-body em{font-style:italic;color:rgba(11,37,69,.55);font-size:.85rem}

.roster-wrap{max-width:56rem;overflow-x:auto;margin:1.25rem 0 2rem;border:1px solid var(--gray-100);border-radius:.6rem}
.roster-table{width:100%;border-collapse:collapse;font-size:.8125rem;background:#fff}
.roster-table th{text-align:left;font-size:.65rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:rgba(11,37,69,.45);padding:.6rem .75rem;background:var(--gray-50);border-bottom:1px solid var(--gray-100);white-space:nowrap}
.roster-table td{padding:.6rem .75rem;border-bottom:1px solid var(--gray-50);color:rgba(11,37,69,.75);white-space:nowrap}
.roster-table tr:last-child td{border-bottom:none}
.roster-table td.pos{font-weight:700;color:var(--green-dark);font-size:.7rem}
.roster-table td.grade{font-weight:700;color:rgba(11,37,69,.55);font-size:.75rem}
.article-body ul.dfs-list{margin:.25rem 0 1.25rem}
.article-body ul.dfs-list li{font-size:.9375rem;line-height:1.7;color:rgba(11,37,69,.75);margin-bottom:.5rem;padding-left:1.1rem;position:relative}
.article-body ul.dfs-list li::before{content:"\2022";color:var(--green);font-weight:700;position:absolute;left:0}
.roster-table td.name{font-weight:600;color:var(--navy)}
.roster-table tr.total td{font-weight:700;color:var(--navy);background:var(--gray-50)}
.signal-CORE{color:var(--green-dark);font-weight:700}
.signal-VALUE{color:var(--gold);font-weight:700}
.signal-WATCH{color:rgba(11,37,69,.5);font-weight:700}

.translation-row{display:flex;flex-wrap:wrap;gap:.5rem;margin:.5rem 0 1.5rem}
.translation-pill{font-size:.8rem;background:#fff;border:1px solid var(--gray-100);border-radius:.4rem;padding:.5rem .75rem;line-height:1.4}
.translation-pill b{display:block;font-size:.65rem;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.15rem}
.translation-pill.core b{color:var(--green-dark)}
.translation-pill.value b{color:var(--gold)}
.translation-pill.watch b{color:rgba(11,37,69,.45)}

.factcheck{max-width:42rem;background:#fff;border:1px solid var(--gray-100);border-radius:.6rem;padding:1.25rem 1.5rem;margin-top:2rem}
.factcheck-label{font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:rgba(11,37,69,.4);margin-bottom:.75rem}
.factcheck li{font-size:.8125rem;line-height:1.6;display:flex;align-items:flex-start;gap:.5rem;color:rgba(11,37,69,.65);margin-bottom:.5rem}
.factcheck li:last-child{margin-bottom:0}
.factcheck li::before{content:'✓';color:var(--green);font-weight:700;flex-shrink:0}

footer{background:var(--navy-dark);color:rgba(255,255,255,.6);padding:2.5rem 0}
.footer-inner{display:flex;flex-direction:column;align-items:center;justify-content:space-between;gap:1rem;font-size:.875rem}
@media(min-width:640px){.footer-inner{flex-direction:row}}
.footer-logo{display:flex;align-items:center;gap:.5rem;color:#fff;font-weight:600}
.footer-links{display:flex;gap:1.5rem}
.footer-links a:hover{color:#fff;transition:color .15s}
</style>
</head>
