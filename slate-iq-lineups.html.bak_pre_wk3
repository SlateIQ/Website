            <tr><td class="pos">RB</td><td>&ge; 18</td><td>&ge; 12</td><td>2.5</td><td>$5,800</td><td>65th</td></tr>
            <tr><td class="pos">WR</td><td>&ge; 16</td><td>&ge; 11</td><td>2.4</td><td>$5,200</td><td>65th</td></tr>
            <tr><td class="pos">TE</td><td>&ge; 15</td><td>&ge; 10</td><td>2.5</td><td>$3,700</td><td>65th</td></tr>
            <tr><td class="pos">DST</td><td>&ge; 7.5</td><td>top 42% (58th pct)</td><td>2.4</td><td>$2,600</td><td>65th</td></tr>
          </tbody>
